      "author": null,
      "contributor": null,
      "rationale": "Triggers on push to main; builds, signs, and publishes one container image per service to ghcr.io so the Kubernetes deployments can pull pinned commit-sha images."
    },
    {
      "id": "_github_workflows_cd_docker_build_job",
      "label": "Docker Image Build Matrix Job",
      "file_type": "concept",
