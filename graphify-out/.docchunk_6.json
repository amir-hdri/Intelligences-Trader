      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "fail-fast: false so every service's build result shows instead of cancelling siblings on the first failure; context is the repository root so Dockerfiles can COPY the committed npm workspace manifests and run npm ci against the root package-lock.json for reproducible images."
