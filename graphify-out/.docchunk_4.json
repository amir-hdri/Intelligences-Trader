      "file_type": "concept",
      "source_file": "/Users/amirheidari/GitHub/Intelligences-Trader/robot trader/server/README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "modelManager.monitorDrift smooths the normalized prediction entropy with an EMA and reports detected:true once at least 30 samples have been observed and the score exceeds the threshold (0.65)."
    },
    {
      "id": "robot_trader_server_readme_retraining_recommendation",
      "label": "Retraining Recommendation (offline, operator-triggered)",
      "file_type": "concept",
      "source_file": "/Users/amirheidari/GitHub/Intelligences-Trader/robot trader/server/README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Recommendation, not automation: the server monitors concept drift and recommends an offline retraining run; it does not retrain or hot-swap models on the request path. When drift is detected the response carries retrainRecommended:true and a warning is logged; no model version is fabricated and no weights are regenerated in-process."
    },
    {
      "id": "robot_trader_server_readme_hot_reload",
      "label": "Hot Reload (modelManager.hotReload)",
      "file_type": "concept",
      "source_file": "/Users/amirheidari/GitHub/Intelligences-Trader/robot trader/server/README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "hotReload(newModelPath, newVersion) can swap an ONNX artifact in memory, but it has no caller in the current request path — it is a maintenance entry point, not a zero-downtime retraining loop."
    }
