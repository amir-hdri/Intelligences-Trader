{
  "nodes": [
    {"id": "api_docs_authentication", "label": "API Authentication (Bearer token, login/refresh)", "file_type": "document", "source_file": "/Users/amirheidari/GitHub/Intelligences-Trader/API_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AUTH_REQUIRED=true (or NODE_ENV=production with no override) enforces a Bearer access token on all /api routes except status/login/refresh; access tokens expire after 15 minutes, refresh tokens after one hour; token responses use Cache-Control: no-store."},
    {"id": "api_docs_positions_endpoint", "label": "GET /api/positions (PROCESS_LOCAL_PAPER_POSITION_LEDGER)", "file_type": "document", "source_file": "/Users/amirheidari/GitHub/Intelligences-Trader/API_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicitly recorded open paper positions only; if none recorded, data is an empty array and the service never creates sample positions. Provenance simulated:true, simulationType PAPER_TRADING."},
    {"id": "api_docs_orders_endpoint", "label": "GET /api/orders (PROCESS_LOCAL_PAPER_ORDER_LEDGER)", "file_type": "document", "source_file": "/Users/amirheidari/GitHub/Intelligences-Trader/API_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicitly submitted legacy paper orders only; generated sample orders are not returned. States PENDING, FILLED, PARTIAL_FILLED, CANCELLED, REJECTED. Prefer P2 order-state endpoints for fill transitions."},
    {"id": "api_docs_performance_endpoint", "label": "GET /api/performance (REALIZED_PAPER_TRADE_LEDGER)", "file_type": "document", "source_file": "/Users/amirheidari/GitHub/Intelligences-Trader/API_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Metrics computed only from explicitly recorded paper outcomes, never generated winners; zero/null for an empty ledger. sharpe = (avgReturn/stdDev)*sqrt(252)."},
    {"id": "api_docs_models_endpoint", "label": "GET /api/models (MODEL_REGISTRY)", "file_type": "document", "source_file": "/Users/amirheidari/GitHub/Intelligences-Trader/API_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Model metrics come from the real Model Registry instead of a constant 'Inference: 18ms'; unknown evaluation metrics report null and latency appears only after measurement."},
    {"id": "api_docs_status_endpoint", "label": "GET /api/status (real metrics override)", "file_type": "document", "source_file": "/Users/amirheidari/GitHub/Intelligences-Trader/API_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Overridden to return real measured metrics rather than hard-coded values; /api/models/status is an alias with full metrics."},
    {"id": "api_docs_learning_endpoint", "label": "GET /api/learning (DETERMINISTIC_RESEARCH_FIXTURE)", "file_type": "document", "source_file": "/Users/amirheidari/GitHub/Intelligences-Trader/API_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns a deterministic fixture history for UI/research testing; it is not a live Python training ledger. Provenance simulated:true, simulationType RESEARCH."},
    {"id": "api_docs_paper_trading_execute", "label": "POST /api/paper-trading/execute (DETERMINISTIC_PAPER_SIMULATOR)", "file_type": "document", "source_file": "/Users/amirheidari/GitHub/Intelligences-Trader/API_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compatibility endpoint that resolves a deterministic research outcome from forecast alignment; it is not a broker fill. Use P2 or Phase 3 for fill/path-based simulation."},
    {"id": "api_docs_p2_paper_trading_engine", "label": "P2 Paper Trading Engine (/api/paper-trading/p2/*)", "file_type": "document", "source_file": "/Users/amirheidari/GitHub/Intelligences-Trader/API_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fill/path-based engine: ML signal mapping, order state machine, order-book simulator, OHLCV/tick ingestion, PostgreSQL trade persistence, and strategy configuration; the modern replacement for the legacy deterministic execute endpoint."},
    {"id": "api_docs_market_intelligence_ml", "label": "Market Intelligence & Machine Learning endpoints (/api/analyze,/predict,/news,/tse/*,/train)", "file_type": "document", "source_file": "/Users/amirheidari/GitHub/Intelligences-Trader/API_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Synchronous rule-based analyze with async TCN ONNX shadow mode, direct ONNX predict with [batch,30,10] tensor input, deterministic fixture news, TSETMC snapshot with synthetic history/digital-twin fallback, multi-timeframe history with ATR regime and 95% VaR, and fractional-differentiation purged-CV TCN training."},
    {"id": "api_docs_proxy_gateway_server", "label": "Proxy Gateway Server (server/, port 3001)", "file_type": "document", "source_file": "/Users/amirheidari/GitHub/Intelligences-Trader/API_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separate Express/WebSocket gateway: TSETMC instrument history with 15s FIFO cache and digital-twin fallback, 5-level deterministic order book with synthetic spoofing flag, Prometheus metrics, and 100ms tick/order-book WebSocket streaming with 30s heartbeat."},
    {"id": "api_docs_phase3_backtesting", "label": "Phase 3 Backtesting (async runs, datasets, results, compare)", "file_type": "document", "source_file": "/Users/amirheidari/GitHub/Intelligences-Trader/API_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Asynchronous run lifecycle QUEUED->VALIDATING->RUNNING->FINALIZING->COMPLETED (terminal REJECTED/FAILED/CANCELLED); canonical results carry resultHash/configHash and dataset/model/feature/normalizer/scenario hashes; persistence is POSTGRESQL or explicit MEMORY_FALLBACK."},
    {"id": "api_docs_provenance_metadata", "label": "Simulation provenance metadata (simulated:true, simulationType)", "file_type": "concept", "source_file": "/Users/amirheidari/GitHub/Intelligences-Trader/API_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Design principle: every market, ledger, learning, and paper endpoint returns provenance metadata; generated data is marked simulated:true and empty ledgers stay empty instead of manufacturing sample records, making simulation explicit across all boundaries."},
    {"id": "api_docs_migration_from_mocks", "label": "Migration from Mocks (mock -> ledger-derived)", "file_type": "document", "source_file": "/Users/amirheidari/GitHub/Intelligences-Trader/API_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "api_docs_frontend_integration", "label": "Frontend Integration (BackendApiService.ts)", "file_type": "document", "source_file": "/Users/amirheidari/GitHub/Intelligences-Trader/API_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frontend service BackendApiService.ts wraps all endpoints via createBackendApi(proxyUrl): getPositions, getPerformance, executePaperTrade, etc."},
    {"id": "api_docs_single_admin_identity_boundary", "label": "Single-admin identity boundary (research deployments, not RBAC)", "file_type": "rationale", "source_file": "/Users/amirheidari/GitHub/Intelligences-Trader/API_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The built-in single-admin JWT identity is deliberately scoped to restricted research deployments rather than public multi-user identity/RBAC; durable refresh-token rotation, MFA, and external IdP remain ASPIRATIONAL beyond that deployment."},
    {"id": "api_docs_deterministic_paper_simulator", "label": "Deterministic paper simulator outcome rule", "file_type": "rationale", "source_file": "/Users/amirheidari/GitHub/Intelligences-Trader/API_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WIN if forecastAlignment==1 && confidence>=threshold, else WIN if regime==TRENDING_UP && side==BUY && confidence>=0.55, else LOSS; pnl = riskPerTrade*profitFactor on WIN else -riskPerTrade. Outcome is forecast-derived, not a broker fill."},
    {"id": "api_docs_canonical_backtest_results", "label": "Canonical backtest result hashing (resultHash/configHash)", "file_type": "concept", "source_file": "/Users/amirheidari/GitHub/Intelligences-Trader/API_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Canonical results include resultHash, configHash, and dataset/model/feature/normalizer/scenario hashes plus order transitions, fills, trades, equity, metrics, regime attribution, risk rejections, and quality warnings; undefined ratios (e.g. Profit Factor with no losses) are null with a machine-readable reason, never JSON Infinity."},
