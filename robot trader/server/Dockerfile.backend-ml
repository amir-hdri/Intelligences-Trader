FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json ./
COPY ["robot trader/package.json", "robot trader/package.json"]
COPY ["robot trader/server/package.json", "robot trader/server/package.json"]
COPY ["server/package.json", "server/package.json"]
RUN --mount=type=cache,target=/root/.npm \
    npm ci --omit=dev --workspace "./robot trader/server" --include-workspace-root=false --no-audit --no-fund
COPY --chown=node:node ["robot trader/server", "robot trader/server"]
WORKDIR "/app/robot trader/server"
# Runtime hardening (runs as root before dropping to `node`): the app executes
# `node index.js` directly and never needs npm. Removing it shrinks the image
# and eliminates the vulnerable libraries npm bundles internally (tar,
# sigstore, brace-expansion, picomatch).
RUN rm -rf /usr/local/lib/node_modules/npm \
    /usr/local/lib/node_modules/corepack \
    /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD wget -qO- http://127.0.0.1:3000/api/status >/dev/null || exit 1
CMD ["node", "index.js"]
