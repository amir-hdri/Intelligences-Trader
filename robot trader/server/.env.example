# Intelligences-Trader — ML / Analysis Backend environment (copy to `.env`)
# The backend refuses to start without JWT_SECRET and REFRESH_SECRET (secure by default).

# --- Server ---
PORT=3000
NODE_ENV=development
# Comma-or-single origin allowed by the CORS middleware.
CORS_ORIGIN=http://localhost:5173

# --- Database ---
# Path to the SQLite file. In-memory (":memory:") is for tests only.
DB_PATH=./data/trader.db

# --- Authentication ---
# Generate strong random values (see scripts/generate-secrets.sh). Never commit real secrets.
JWT_SECRET=change-me-to-a-strong-random-value
REFRESH_SECRET=change-me-to-a-strong-random-value

# --- Seeded admin credentials (used on first boot when the DB is empty) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# --- Optional: encryption key for SecretManager ---
MASTER_ENCRYPTION_KEY=
