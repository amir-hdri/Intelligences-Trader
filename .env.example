# Browser origin allowed by both HTTP services. Comma-separate additional origins.
PUBLIC_ORIGIN=http://localhost:5173
NODE_ENV=development

# Authentication is optional only for local research. Set true in every shared,
# staging, or production deployment and replace all example values.
AUTH_REQUIRED=
JWT_SECRET=
REFRESH_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Internal persistence/cache configuration used by Docker Compose.
POSTGRES_USER=paper
POSTGRES_PASSWORD=development-only-paper
POSTGRES_DB=paper_trading
DATABASE_URL=postgres://paper:development-only-paper@postgres:5432/paper_trading
REDIS_URL=redis://redis:6379

# Runtime limits.
BACKTEST_MAX_CONCURRENT=2
BACKTEST_MAX_QUEUED=100
TRUST_PROXY_HOPS=1
ENABLE_EXPERIMENTAL_SIMULATIONS=false

# Optional model pin. Defaults to the tracked research artifact.
MODEL_VERSION=1.0.0
MODEL_PATH=
