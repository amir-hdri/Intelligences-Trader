FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json ./
COPY ["robot trader/package.json", "robot trader/package.json"]
COPY ["robot trader/server/package.json", "robot trader/server/package.json"]
COPY ["server/package.json", "server/package.json"]
RUN --mount=type=cache,target=/root/.npm \
    npm ci --omit=dev --workspace "./server" --include-workspace-root=false --no-audit --no-fund
COPY --chown=node:node server server
WORKDIR /app/server
USER node
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1:3001/api/status >/dev/null || exit 1
CMD ["node", "index.js"]
