# Stage 1: Build
FROM node:22-alpine AS builder
WORKDIR /app
RUN --mount=type=cache,target=/root/.npm npm set cache /root/.npm
COPY package*.json ./
RUN npm ci || npm install --no-audit --no-fund
COPY . .

# Stage 2: Production Runtime
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

# Install pm2 for process management
RUN npm install -g pm2 && addgroup -g 1001 nodejs && adduser -S -u 1001 -G nodejs nodejs

COPY --from=builder --chown=nodejs:nodejs /app ./

RUN --mount=type=cache,target=/root/.npm npm ci --only=production || npm install --only=production --no-audit --no-fund

USER nodejs
EXPOSE 3001

# Run with PM2 in cluster mode to utilize multiple CPU cores
CMD ["pm2-runtime", "start", "index.js", "-i", "max"]
