# Intelligences-Trader — Data Proxy Gateway environment (copy to `.env`)
# The gateway holds no credentials of its own; it forwards market data only.

PORT=3001
NODE_ENV=development
# Origin allowed by the CORS middleware and the WebSocket upgrade check.
CORS_ORIGIN=http://localhost:5173
# Number of trusted reverse proxies in front of this service (0 = direct).
# Used for correct client-IP resolution behind Nginx/Kubernetes ingress.
TRUST_PROXY_HOPS=1
